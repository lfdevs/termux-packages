+    return nullptr;
+}
+
+}
+
+#else
+
 #include <libudev.h>
 
 namespace KWin
@@ -316,3 +442,5 @@ std::unique_ptr<UdevDevice> UdevMonitor::getDevice()
 }
 
 }
+
+#endif
