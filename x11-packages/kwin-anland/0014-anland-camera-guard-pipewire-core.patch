From 6e4097832dc79fd9e794cd3e7997c2f6db10bb84 Mon Sep 17 00:00:00 2001
From: lfdevs <lfdevs@lfdevs.com>
Date: Sat, 10 Oct 2026 01:08:47 +0800
Subject: [PATCH] backends/anland: defer camera nodes until PipeWire is
 connected

The camera resource event can arrive while the PipeWire thread loop is still
reconnecting. Avoid passing a null core to pw_stream_new; the stored stream
fds are picked up when the reconnect timer establishes the core.
---
 src/backends/anland/anland_camera.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/backends/anland/anland_camera.c b/src/backends/anland/anland_camera.c
index b29cfb6fb6..78158ad454 100644
--- a/src/backends/anland/anland_camera.c
+++ b/src/backends/anland/anland_camera.c
@@ -512,6 +512,8 @@ static int create_node(struct cam *cam)
 {
     if (cam->node)
         return 0;
+    if (!cam->owner || !cam->owner->pw_connected || !cam->owner->core)
+        return -1;
     cam->streaming = false;
     cam->recording = false;
     cam->process_seen = false;
@@ -536,7 +538,8 @@ static void create_nodes(struct anland_camera *c)
         struct cam *cam = &c->cams[i];
         if (cam->node)
             continue;
-        create_node(cam);
+        if (create_node(cam) < 0)
+            continue;
         if (cam->stream_fd >= 0 && !cam->io)
             cam->io = pw_loop_add_io(loop, cam->stream_fd, SPA_IO_IN, false,
                                      on_stream_readable, cam);
-- 
