+    if (ctx->pre_release_cb)
+        ctx->pre_release_cb(ctx->pre_release_userdata);
 
     release_consumer_resources(ctx);
+
+    if (ctx->fallback_cb)
+        ctx->fallback_cb(ctx->fallback_userdata);
 }
 
 /*
