From 3af5a40346c23d861ec87afb0bd0cbd2490385a1 Mon Sep 17 00:00:00 2001
From: lfdevs <lfdevs@lfdevs.com>
Date: Fri, 14 Aug 2026 22:27:06 +0800
Subject: [PATCH 12/21] plugins/qpa: fall back to software without a DRM device

Force Qt Quick to the software renderer and use shared-memory backing stores
when KWin has no DRM device. Reject non-dma-buf buffers in the OpenGL QPA path.
---
 src/compositor.cpp                     | 7 ++++++-
 src/plugins/qpa/eglplatformcontext.cpp | 8 +++++++-
 src/plugins/qpa/window.cpp             | 7 +++++--
 3 files changed, 18 insertions(+), 4 deletions(-)

diff --git a/src/compositor.cpp b/src/compositor.cpp
index d6ae70bb10..2d09981696 100644
--- a/src/compositor.cpp
+++ b/src/compositor.cpp
@@ -369,7 +369,12 @@ void Compositor::start()
         case NoCompositing:
             break;
         case OpenGLCompositing:
-            QQuickWindow::setGraphicsApi(QSGRendererInterface::OpenGL);
+            if (const RenderDevice *renderDevice = m_backend->renderDevice(); renderDevice && renderDevice->drmDevice()) {
+                QQuickWindow::setGraphicsApi(QSGRendererInterface::OpenGL);
+            } else {
+                qCWarning(KWIN_CORE) << "No DRM device available; forcing Qt Quick to use the software renderer";
+                QQuickWindow::setGraphicsApi(QSGRendererInterface::Software);
+            }
             break;
         case QPainterCompositing:
             QQuickWindow::setGraphicsApi(QSGRendererInterface::Software);
diff --git a/src/plugins/qpa/eglplatformcontext.cpp b/src/plugins/qpa/eglplatformcontext.cpp
index d278548f99..ddeadb2df7 100644
--- a/src/plugins/qpa/eglplatformcontext.cpp
+++ b/src/plugins/qpa/eglplatformcontext.cpp
@@ -96,7 +96,13 @@ bool EGLPlatformContext::makeCurrent(QPlatformSurface *surface)
         if (it != m_renderTargets.end()) {
             m_current = it->second;
         } else {
-            std::shared_ptr<GLTexture> texture = m_eglContext->importDmaBufAsTexture(*buffer->dmabufAttributes());
+            const DmaBufAttributes *attributes = buffer->dmabufAttributes();
+            if (!attributes) {
+                qCWarning(KWIN_QPA) << "Cannot import a non-dma-buf graphics buffer into an OpenGL context";
+                return false;
+            }
+
+            std::shared_ptr<GLTexture> texture = m_eglContext->importDmaBufAsTexture(*attributes);
             if (!texture) {
                 return false;
             }
diff --git a/src/plugins/qpa/window.cpp b/src/plugins/qpa/window.cpp
index f5cdbf80aa..a42b8f113b 100644
--- a/src/plugins/qpa/window.cpp
+++ b/src/plugins/qpa/window.cpp
@@ -48,7 +48,10 @@ Window::~Window()
 Swapchain *Window::swapchain(const std::shared_ptr<EglContext> &context, const FormatModifierMap &formats)
 {
     const QSize nativeSize = geometry().size() * devicePixelRatio();
-    const bool software = window()->surfaceType() == QSurface::RasterSurface; // RasterGLSurface is unsupported by us
+    const bool isRaster = window()->surfaceType() == QSurface::RasterSurface; // RasterGLSurface is unsupported by us
+    RenderDevice *renderDevice = Compositor::self()->primaryDevice();
+    DrmDevice *device = isRaster || !renderDevice ? nullptr : renderDevice->drmDevice();
+    const bool software = isRaster || !device;
     if (!m_swapchain || m_swapchain->size() != nativeSize
         || !formats.containsFormat(m_swapchain->format(), m_swapchain->modifier())
         || (!software && m_eglContext.lock() != context)) {
@@ -57,7 +60,7 @@ Swapchain *Window::swapchain(const std::shared_ptr<EglContext> &context, const F
             static ShmGraphicsBufferAllocator shmAllocator;
             allocator = &shmAllocator;
         } else {
-            allocator = Compositor::self()->primaryDevice()->allocator();
+            allocator = device->allocator();
         }
 
         for (auto it = formats.begin(); it != formats.end(); it++) {
