@@ -136,12 +138,15 @@ AnlandBackend::~AnlandBackend()
     // m_outputs are QObject children of this backend; ~QObject deletes them.
     m_outputs.clear();
     m_inputDevice.reset();
+    if (m_renderDevice && GpuManager::self()) {
+        GpuManager::self()->removeDevice(m_renderDevice);
+        m_renderDevice = nullptr;
+    }
     if (m_display) {
         ::disconnect(m_display); // C producer API, not QObject::disconnect
         m_display = nullptr;
     }
-    // m_renderDevice (or m_eglDisplay in no-DRM mode) owns the EglDisplay;
-    // the 5.27-era manual eglTerminate(sceneEglDisplay()) is no longer needed.
+    // GpuManager owns the render device and its EglDisplay.
 }
 
 bool AnlandBackend::initialize()
@@ -166,20 +171,25 @@ bool AnlandBackend::initialize()
 
     m_noDrmDeviceMode = noDrmDeviceRequested();
     if (m_noDrmDeviceMode) {
-        qCWarning(KWIN_ANLAND) << "ANLAND_NO_DRM_DEVICE is enabled; using surfaceless EGL without a KWin DrmDevice";
-        m_eglDisplay = createSurfacelessEglDisplay(nullptr);
-        if (!m_eglDisplay) {
+        qCWarning(KWIN_ANLAND) << "ANLAND_NO_DRM_DEVICE is enabled; using surfaceless EGL without a DRM device";
+        auto eglDisplay = createSurfacelessEglDisplay(nullptr);
+        if (!eglDisplay) {
             qCWarning(KWIN_ANLAND) << "could not create surfaceless EGL display";
             return false;
         }
+        auto renderDevice = std::make_unique<RenderDevice>(
+            std::make_unique<UDmabufAllocator>(), std::move(eglDisplay), dev_t{0});
+        m_renderDevice = renderDevice.get();
+        GpuManager::self()->addDevice(std::move(renderDevice));
     } else {
-        // KWin dereferences renderBackend->drmDevice() during OpenGL compositor
-        // setup; without a real device it segfaults. Open one up front.
-        m_renderDevice = openRenderDevice();
-        if (!m_renderDevice) {
+        // Open and register the render device before KWin selects the primary GPU.
+        auto renderDevice = openRenderDevice();
+        if (!renderDevice) {
             qCWarning(KWIN_ANLAND) << "no usable DRM render device; cannot bring up OpenGL compositing";
             return false;
         }
+        m_renderDevice = renderDevice.get();
+        GpuManager::self()->addDevice(std::move(renderDevice));
     }
 
     m_inputDevice = std::make_unique<AnlandInputDevice>();
@@ -226,9 +236,10 @@ bool AnlandBackend::initialize()
     return true;
 }
 
