+if have_anland
+  mutter_sources += [
+    'backends/anland/meta-backend-anland.c',
+    'backends/anland/meta-backend-anland.h',
+  ]
+endif
+
 if have_wayland or have_native_backend
   mutter_sources += [
     'common/meta-cogl-drm-formats.c',
