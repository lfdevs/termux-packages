+                                                      &event,
+                                                      backend->screen_info.width,
+                                                      backend->screen_info.height);
       if (input_result == META_ANLAND_INPUT_EVENT_NEEDS_PAYLOAD)
         {
           if (!handle_extended_input (backend, &event))
