+                       "A native backend without logind must run headlessly");
+  return FALSE;
+#else
   g_autoptr (MetaLauncher) launcher = NULL;
   g_autoptr (GError) local_error = NULL;
 
@@ -856,6 +887,7 @@ meta_backend_native_create_launcher (MetaBackend   *backend,
 
