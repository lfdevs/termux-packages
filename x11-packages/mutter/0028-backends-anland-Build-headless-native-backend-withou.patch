                 GUdevDevice        *device,
@@ -626,7 +633,6 @@ add_drm_device (MetaBackendNative  *backend_native,
   meta_backend_add_gpu (META_BACKEND (backend_native), META_GPU (gpu_kms));
   return TRUE;
 }
-
